{
  "name": "monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "monorepo",
      "workspaces": ["packages/*"],
      "devDependencies": {
        "@stellar/stellar-base": "15.0.0"
      }
    },
    "node_modules/@stellar/stellar-base": {
      "version": "15.0.0",
      "dev": true
    },
    "node_modules/web": {
      "resolved": "packages/web",
      "link": true
    },
    "packages/web": {
      "version": "1.0.0",
      "dependencies": {
        "@stellar/stellar-sdk": "^17.0.0"
      }
    },
    "packages/web/node_modules/@stellar/stellar-sdk": {
      "version": "17.3.0"
    }
  }
}

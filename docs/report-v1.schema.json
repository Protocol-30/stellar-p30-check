{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p30check scan report, schema version 1",
  "description": "A local discovery and static-analysis report. Complete discovery and zero findings do not certify Protocol 30 compatibility. In M1, coverage.rules_implemented is zero.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "target", "checked_at_utc", "findings", "summary", "limitations", "inventory", "coverage"],
  "properties": {
    "schema_version": { "const": "1" },
    "tool_version": { "type": "string" },
    "target": { "type": "string" },
    "checked_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "summary": { "$ref": "#/$defs/summary" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "inventory": { "type": "array", "items": { "$ref": "#/$defs/inventory_item" } },
    "coverage": { "$ref": "#/$defs/coverage" },
    "error": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "severity", "confidence", "path", "message", "evidence", "remediation", "references"],
      "properties": {
        "rule_id": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "medium", "high"] },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "message": { "type": "string" },
        "evidence": { "type": "string" },
        "remediation": { "type": "string" },
        "references": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "info", "medium", "high"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 }
      }
    },
    "inventory_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "size"],
      "properties": {
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "coverage": {
      "type": "object",
      "description": "Complete covers the selected regular-file discovery scope, not semantic compatibility. Deliberate exclusions appear in skipped. Unexpected traversal, read, or resource-limit failures set complete to false and exit 2.",
      "additionalProperties": false,
      "required": ["complete", "rules_implemented", "files_scanned", "entries_visited", "bytes_read", "skipped"],
      "properties": {
        "complete": { "type": "boolean" },
        "rules_implemented": { "type": "integer", "minimum": 0 },
        "files_scanned": { "type": "integer", "minimum": 0 },
        "entries_visited": { "type": "integer", "minimum": 0 },
        "bytes_read": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "array", "items": { "$ref": "#/$defs/skipped" } }
      }
    }
  }
}

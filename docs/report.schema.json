{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "p30check scan report, schema version 2",
  "description": "A local discovery and static dependency-analysis report. Complete discovery, known observed-version capabilities, and zero findings do not certify Protocol 30 compatibility. Schema version 2 adds dependency inventory and warnings; version 1 is preserved in report-v1.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "target",
    "checked_at_utc",
    "findings",
    "summary",
    "limitations",
    "inventory",
    "coverage",
    "dependencies",
    "dependency_warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "tool_version": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "checked_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inventory_item"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "dependency_warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency_warning"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "severity",
        "confidence",
        "path",
        "message",
        "evidence",
        "remediation",
        "references"
      ],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "medium",
            "high"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "info",
        "medium",
        "high"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "inventory_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "Complete covers the selected regular-file discovery scope, not semantic compatibility. Deliberate exclusions appear in skipped. Unexpected traversal, read, or resource-limit failures set complete to false and exit 2.",
      "additionalProperties": false,
      "required": [
        "complete",
        "rules_implemented",
        "files_scanned",
        "entries_visited",
        "bytes_read",
        "skipped"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "rules_implemented": {
          "type": "integer",
          "minimum": 0
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "entries_visited": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_read": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skipped"
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystem",
        "name",
        "group",
        "scope",
        "path",
        "declared",
        "version",
        "resolution",
        "source",
        "effective",
        "uncertainty"
      ],
      "properties": {
        "ecosystem": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "alias": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "declared": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "effective": {
          "type": "boolean"
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        }
      },
      "description": "Observed declarations and lock records. Capabilities describe version only; effective indicates whether the available static evidence establishes selected applicability. Uncertainty is explicit and never implies a clean result."
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_version",
        "checked_at",
        "version",
        "cap88",
        "muxed_contract_xdr",
        "w_address_helpers",
        "references"
      ],
      "properties": {
        "matrix_version": {
          "type": "string"
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        },
        "version": {
          "type": "string"
        },
        "cap88": {
          "type": "string",
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "muxed_contract_xdr": {
          "type": "string",
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "w_address_helpers": {
          "type": "string",
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Evidence-backed capabilities for an observed version. This does not certify effective selection or application runtime behavior."
    },
    "dependency_warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "code",
        "message"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
